{
  "name": "@sudobility/characterbuilder_lib",
  "version": "0.1.2",
  "description": "Frontend business logic for CharacterBuilder: FaceSpec draft store, form metadata, prompt preview",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "dependencies": {
    "@sudobility/characterbuilder_client": "^0.1.2",
    "@sudobility/characterbuilder_types": "^0.1.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tanstack/react-query": "^5.90.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.4",
    "zustand": "^5.0.9"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnqh/characterbuilder_lib.git"
  }
}
