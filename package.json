{
  "name": "@sudobility/characterbuilder_lib",
  "version": "0.1.5",
  "description": "Frontend business logic for CharacterBuilder: FaceSpec draft store, form metadata, prompt preview",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "dependencies": {
    "@sudobility/characterbuilder_client": "^0.1.5",
    "@sudobility/characterbuilder_types": "^0.1.6"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@tanstack/react-query": "~5.104.5",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/characterbuilder_lib.git"
  }
}
