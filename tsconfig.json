{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@sudobility/characterbuilder_types": ["../characterbuilder_types/src/index.ts"],
      "@sudobility/characterbuilder_client": ["../characterbuilder_client/src/index.ts"]
    }
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
